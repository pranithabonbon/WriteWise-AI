# ---------- Flask ----------
APP_ENV=development
FLASK_DEBUG=1
SECRET_KEY=
PORT=5001

# ---------- CORS ----------
# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Upload limits (Phase 4) ----------
MAX_UPLOAD_MB=5

# ---------- MongoDB Atlas (Phase 2) ----------
MONGODB_URI=
MONGODB_DB_NAME=writewise_ai
MONGODB_TIMEOUT_MS=5000

# ---------- LLM API (Phase 5) ----------
# Choose either anthropic or gemini. Keep provider keys server-side only.
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=
# Used when LLM_PROVIDER=gemini. Get a key from Google AI Studio.
GEMINI_API_KEY=
# Set this to a Gemini model enabled for your API key.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# Optional: use a preinstalled local LanguageTool directory.
# On Render, backend/Dockerfile installs Java and downloads LanguageTool at build time.
# WRITEWISE_LANGUAGETOOL_JAR_DIR=

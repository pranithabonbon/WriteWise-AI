# ---------- Flask ----------
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
PORT=5001

# ---------- CORS ----------
# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Upload limits (Phase 4) ----------
MAX_UPLOAD_MB=5

# ---------- MongoDB Atlas (Phase 2) ----------
MONGODB_URI=
MONGODB_DB_NAME=writewise_ai

# ---------- LLM API (Phase 5) ----------
# Choose either anthropic or gemini. Keep provider keys server-side only.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Used when LLM_PROVIDER=gemini. Get a key from Google AI Studio.
GEMINI_API_KEY=
# Set this to a model enabled for the selected provider; e.g. gemini-3.5-flash-lite.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
